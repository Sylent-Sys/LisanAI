OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PORT=4173
# HTTP-Referer sent to OpenRouter. Set to your production domain in deployment.
# OPENROUTER_REFERER=https://lisan-ai-assessment.vercel.app

# Trustworthy assessment harness (evidence verification, publication gate,
# reproducibility hashes, reliability vector, risk-based adaptive verification).
# The harness is the SINGLE evaluation engine; the legacy LLM path was removed
# in P1-15/P1-16.
HARNESS_PROVIDER=openrouter
# Max model re-runs when verification FAILs (bounded retry, 0 = single attempt).
MAX_EVALUATION_RETRIES=1
# Demo simulation widget (dev convenience for switching between seeded users).
ENABLE_DEMO_SIMULATION=false

# Auth hardening.
# CSRF_SECRET: RAHASIA acak (minimal 32 karakter). WAJIB di produksi; aplikasi
# menolak membuat CSRF token bila kosong saat VERCEL_ENV/NODE_ENV=production.
# Di luar produksi, fallback dev dipakai bila kosong.
CSRF_SECRET=
# TURSO_DATABASE_URL: SQLite/libSQL. Untuk pengembangan lokal gunakan file:./data/lisan_ai.db.
# Untuk Turso remote gunakan URL libsql (libsql://...).
TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN: token akses untuk Turso remote. Kosongkan bila memakai file lokal.
TURSO_AUTH_TOKEN=

# PostgreSQL (server API). Bila DATABASE_URL diisi postgres://..., nilainya
# dipakai menggantikan TURSO_DATABASE_URL. Pakai user khusus aplikasi
# (scripts/pg-bootstrap.js), bukan superuser postgres.
# DATABASE_URL=postgres://lisanai_app:<password>@<host>:5432/lisanai
# disable | require (terenkripsi, sertifikat tidak diverifikasi) | verify
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=10

# Server web saja: teruskan /api/* ke server API dan jangan buka database di sini.
# API_UPSTREAM_URL=http://<ip-server-api>:4173
